node_modules
dist
.DS_Store
playwright-report/
test-results/
*.tar.gz
__pycache__/
.venv/

# Replit workspace artifacts.
#
# Replit generates these inside the checkout. Left untracked they make the
# tree permanently dirty, and Replit's git integration will not pull or merge
# over a dirty tree - which surfaces as "cannot merge" rather than as the
# untracked-files problem it actually is.
.config/
.upm/
.cache/
.local/
.pythonlibs/
.breakpoints
.replit_history
replit_zip_error_log.txt
attached_assets/

# TypeScript incremental build caches.
*.tsbuildinfo

# Replit environment scaffolding, generated by the workspace rather than
# written for this project. Kept out of the repo deliberately - but ignored
# rather than merely untracked, because an untracked file dirties the tree and
# Replit will not merge over a dirty tree.
#
# If this project ever adopts a real pyproject.toml for the tools/ scripts,
# delete that line first: an ignore rule will silently swallow it otherwise.
main.py
pyproject.toml
uv.lock
.replit_agent/
.agent_memory/
