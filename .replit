# Replit configuration.
#
# Static deployment target: this app builds to exactly one self-contained
# HTML file with no server, so there is nothing to run in production.
# See docs/ARCHITECTURE.md §1.

modules = ["nodejs-20", "python-3.12"]
run = "npm run dev"
entrypoint = "index.html"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "static"
publicDir = "dist/public"
build = ["npm", "run", "build"]

[env]
NODE_ENV = "development"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
