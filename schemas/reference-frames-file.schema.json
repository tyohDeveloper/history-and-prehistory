{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-picker.local/schemas/reference-frames-file.schema.json",
  "title": "Reference frames file (reference-frames.json)",
  "type": "object",
  "required": ["schema_version", "dataset_version", "frames"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "reference-frame.schema.json" }
    }
  }
}
